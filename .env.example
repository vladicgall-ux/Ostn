# Copy to .env (or set as environment variables in the BotHost panel).

# Token issued by @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Get your ID from @userinfobot. Leave empty to allow anyone (not recommended).
ALLOWED_USER_IDS=

# SpiderFoot is started by telegram_bot.py itself and bound to localhost only.
SPIDERFOOT_HOST=127.0.0.1
SPIDERFOOT_PORT=5001

# Default module set for /scan when no usecase argument is given:
# passive, footprint, investigate, all
SPIDERFOOT_USECASE=footprint

# How often (seconds) the bot polls a running scan for completion
POLL_INTERVAL_SECONDS=20
