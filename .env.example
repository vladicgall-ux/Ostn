# Скопируйте в .env (или задайте как переменные окружения в панели BotHost).

# Токен, выданный @BotFather
TELEGRAM_BOT_TOKEN=

# Через запятую — числовые Telegram ID пользователей, которым разрешено
# пользоваться ботом. Узнать свой ID можно у @userinfobot.
# Оставьте пустым, чтобы разрешить всем (не рекомендуется).
ALLOWED_USER_IDS=

# SpiderFoot запускается самим telegram_bot.py и доступен только локально.
SPIDERFOOT_HOST=127.0.0.1
SPIDERFOOT_PORT=5001

# Набор модулей по умолчанию для /scan, если режим не указан явно:
# passive, footprint, investigate, all
SPIDERFOOT_USECASE=footprint

# Как часто (в секундах) бот проверяет прогресс запущенного скана
POLL_INTERVAL_SECONDS=20
